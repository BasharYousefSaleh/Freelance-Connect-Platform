<!-- نافذة تقديم عرض
================================================== -->
<div id="small-dialog" class="zoom-anim-dialog mfp-hide dialog-with-tabs">

    <!-- التبويبات -->
    <div class="sign-in-form">

        <ul class="popup-tabs-nav">
            <li><a href="#tab">تقديم عرض</a></li>
        </ul>

        <div class="popup-tabs-container">

            <!-- التبويب -->
            <div class="popup-tab-content" id="tab">

                <!-- نص الترحيب -->
                <div class="welcome-text">
                    <h3>ناقش مشروعك مع ديفيد</h3>
                </div>

                <!-- النموذج -->
                <form method="post">

                    <div class="input-with-icon-left">
                        <i class="icon-material-outline-account-circle"></i>
                        <input type="text" class="input-text with-border" name="name" id="name" placeholder="الاسم الأول والأخير" />
                    </div>

                    <div class="input-with-icon-left">
                        <i class="icon-material-baseline-mail-outline"></i>
                        <input type="text" class="input-text with-border" name="emailaddress" id="emailaddress" placeholder="عنوان البريد الإلكتروني" />
                    </div>

                    <textarea name="textarea" cols="10" placeholder="رسالة" class="with-border"></textarea>

                    <div class="uploadButton margin-top-25">
                        <input class="uploadButton-input" type="file" accept="image/*, application/pdf" id="upload" multiple />
                        <label class="uploadButton-button ripple-effect" for="upload">إضافة مرفقات</label>
                        <span class="uploadButton-file-name">أنواع الملفات المسموح بها: zip، pdf، png، jpg <br> الحد الأقصى لحجم الملفات: 50 ميجابايت.</span>
                    </div>

                </form>

                <!-- الزر -->
                <button class="button margin-top-35 full-width button-sliding-icon ripple-effect" type="submit">تقديم عرض <i class="icon-material-outline-arrow-right-alt"></i></button>

            </div>
            <!-- تسجيل الدخول -->
            <div class="popup-tab-content" id="loginn">

                <!-- نص الترحيب -->
                <div class="welcome-text">
                    <h3>ناقش مشروعك مع توم</h3>
                </div>

                <!-- النموذج -->
                <form method="post" id="make-an-offer-form">

                    <div class="input-with-icon-left">
                        <i class="icon-material-outline-account-circle"></i>
                        <input type="text" class="input-text with-border" name="name2" id="name2" placeholder="الاسم الأول والأخير" required />
                    </div>

                    <div class="input-with-icon-left">
                        <i class="icon-material-baseline-mail-outline"></i>
                        <input type="text" class="input-text with-border" name="emailaddress2" id="emailaddress2" placeholder="عنوان البريد الإلكتروني" required />
                    </div>

                    <textarea name="textarea" cols="10" placeholder="رسالة" class="with-border"></textarea>

                    <div class="uploadButton margin-top-25">
                        <input class="uploadButton-input" type="file" accept="image/*, application/pdf" id="upload-cv" multiple />
                        <label class="uploadButton-button" for="upload-cv">إضافة مرفقات</label>
                        <span class="uploadButton-file-name">أنواع الملفات المسموح بها: zip، pdf، png، jpg <br> الحد الأقصى لحجم الملفات: 50 ميجابايت.</span>
                    </div>

                </form>

                <!-- الزر -->
                <button class="button full-width button-sliding-icon ripple-effect" type="submit" form="make-an-offer-form">تقديم عرض <i class="icon-material-outline-arrow-right-alt"></i></button>

            </div>

        </div>
    </div>
</div>
<!-- نافذة تقديم عرض / نهاية -->
