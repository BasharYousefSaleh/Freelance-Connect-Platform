@model Hoor.Web.ViewModels.Contracts.SingleContractViewModel

<div id="upload-work" class="zoom-anim-dialog mfp-hide small-dialog-1">

    <!-- التبويبات -->
    <div class="sign-in-form">

        <ul class="popup-tabs-nav">
            <li><a href="#tab1">رفع العمل</a></li>
        </ul>

        <div class="popup-tabs-container">

            <!-- التبويب -->
            <div class="popup-tab-content" id="tab">

                <!-- نص الترحيب -->
                <div class="welcome-text">
                    <h3>اختر ملفًا تريد رفعه واضغط على إرسال.</h3>
                </div>

                <form id="upload-work-form" enctype="multipart/form-data" asp-action="UploadWork" asp-controller="Contracts">
                    <!-- زر التحميل -->
                    <div class="uploadButton margin-top-0">
                        <input class="uploadButton-input" required name="attachment" type="file" accept="image/*,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/zip" id="upload" />
                        <label class="uploadButton-button ripple-effect" for="upload">رفع الملف</label>
                        <span class="uploadButton-file-name">يمكنك فقط رفع الملفات بصيغ jpeg, pdf, docx, xlsx, pptx, و zip.</span>
                    </div>

                    <input hidden name="contractId" value="@Model.Id"/>

                </form>

                <!-- الزر -->
                <button class="margin-top-15 button w-100 button-sliding-icon ripple-effect" type="submit" form="upload-work-form">إرسال <i class="icon-material-outline-arrow-right-alt"></i></button>

            </div>
        </div>
    </div>
</div>
