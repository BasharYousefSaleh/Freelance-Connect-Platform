@model Hoor.Web.ViewModels.Contracts.SingleContractViewModel
<div id="Inform-contract" class="zoom-anim-dialog mfp-hide small-dialog-1">

    <!-- التبويبات -->
    <div class="sign-in-form">

        <ul class="popup-tabs-nav">
            <li><a href="#tab1">إبلاغ عن العقد</a></li>
        </ul>

        <div class="popup-tabs-container">

            <!-- التبويب -->
            <div class="popup-tab-content" id="tab">

                <!-- نص الترحيب -->
                <div class="welcome-text">
                    <h3>هل أنت متأكد أنك تريد الابلاغ عن هذا العقد مع <br />@Model.FreelancerFirstName @Model.FreelancerLastName?</h3>
                    <h5 class="margin-bottom-30 text-secondary font-italic"> اترك لنا سبب الالغاء في الحقل التالي</h5>

                </div>

                <form id="inform-contract-form" asp-action="InformRecuest" asp-controller="Contracts">
                    <div class="submit-field text-right ">

                        <textarea class="uploadButton-input"  placeholder="اترك لنا رسالة" name="Informdescription" type="text" > </textarea>

                    </div>

                    @* <input type="text" hidden name="action" value="cancel" /> *@
                    <input type="text" hidden name="contractId" value="@Model.Id" />

                </form>

                <!-- زر -->
                <button class="margin-top-15 button w-100 button-sliding-icon ripple-effect" type="submit" form="inform-contract-form">تأكيد الإبلاغ <i class="icon-material-outline-arrow-right-alt"></i></button>

            </div>
        </div>
    </div>
</div>
