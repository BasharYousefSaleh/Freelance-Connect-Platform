@using Hoor.Common;

@model IEnumerable<Hoor.Web.ViewModels.Jobs.UserJobsListViewModel>

<!-- حاوية لوحة التحكم -->
<div class="dashboard-container">

    <div class="dashboard-content-container" data-simplebar style="direction:rtl; text-align:right">
        <div class="dashboard-content-inner" >

            <!-- عنوان لوحة التحكم -->
            <div class="dashboard-headline">
                <h3>وظائفي</h3>
            </div>

            <!-- صف -->
            <div class="row">

                <!-- صندوق لوحة التحكم -->
                <div class="col-xl-12">
                    <div class="dashboard-box margin-top-0">

                        <!-- عنوان -->
                        <div class="headline">
                            <h3><i class="icon-material-outline-business-center"></i> @Model.Count() قائمة وظائف</h3>
                        </div>

                        <div class="content">
                            <ul class="dashboard-box-list">
                                @foreach (var job in this.Model)
                                {
                                    <li>
                                        <!-- قائمة الوظائف -->
                                        <div class="job-listing">

                                            <!-- تفاصيل قائمة الوظائف -->
                                            <div class="job-listing-details">

                                                <!-- التفاصيل -->
                                                <div class="job-listing-description">

                                                    <h3 class="job-listing-title"><a asp-controller="Jobs" asp-action="Index" asp-route-id="@job.Id">@job.Title</a> <span class="dashboard-status-button @job.TagColor">@job.TagName</span></h3>

                                                    <!-- تذييل قائمة الوظائف -->
                                                    <div class="job-listing-footer">
                                                        <ul>
                                                            <li><i class="icon-material-outline-date-range"></i>تم نشره في @job.CreatedOn.ToLongDateString()</li>
                                                        </ul>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        @if (job.Status == JobStatus.Open)
                                        {
                                            <!-- الأزرار -->
                                            <div class="buttons-to-right always-visible">
                                                <a asp-action="All" asp-controller="Offers" asp-route-id="@job.Id" class="button ripple-effect"><i class="icon-material-outline-supervisor-account"></i> إدارة العروض <span class="button-info">@job.OffersCount</span></a>
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <!-- صف / نهاية -->
            <partial name="SmallFooterPartial" />

        </div>
    </div>
    <!-- محتوى لوحة التحكم / نهاية -->
        <partial name="DashboardPartial" />

</div>
