@model Hoor.Web.ViewModels.Dashboard.FreelancerDashboardViewModel

<!-- Dashboard Container -->
<div class="dashboard-container">
    <!-- Dashboard Content ================================================== -->
    <div class="dashboard-content-container text-right" data-simplebar style="direction:rtl; text-align:right">
        <div class="dashboard-content-inner">

            <!-- Dashboard Headline -->
            <div class="dashboard-headline">
                <h3>مرحباً، @Model.Name!</h3>
                <span>نحن سعداء برؤيتك مجددًا!</span>
            </div>

            <!-- Fun Facts Container -->
            <div class="fun-facts-container">
                <div class="fun-fact" data-fun-fact-color="#36bd78">
                    <div class="fun-fact-text">
                        <span>الأموال المكتسبة</span>
                        <h4>@Model.TotalMoneyOngoing</h4>
                    </div>
                    <div class="fun-fact-icon"><i class="icon-feather-dollar-sign"></i></div>
                </div>

                <!-- New Fun Fact: Withdrawable Funds -->
                    @if (decimal.Parse(Model.TotalMoneyEarned)<=0)
                    {
                <div class="fun-fact" data-fun-fact-color="#28a745">

                    <div class="fun-fact-text">
                        <a class="popup-with-zoom-anim   ripple-effect" href="#Payment-Balance">
                        <span>الأموال القابلة للسحب</span>
                        <h4>@Model.TotalMoneyEarned</h4>
                    </a>
                    </div>
                    <div class="fun-fact-icon"><i class="icon-material-outline-account-balance-wallet"></i></div>
                </div>
                    }else{
                <div class="fun-fact" data-fun-fact-color="#28a745">

                    <div class="fun-fact-text">
                    <a  asp-action="Index" asp-controller="Withdrawal">
                        <span>الأموال القابلة للسحب</span>
                        <h4>@Model.TotalMoneyEarned</h4>
                    </a>
                    </div>
                    <div class="fun-fact-icon"><i class="icon-material-outline-account-balance-wallet"></i></div>
                </div>
                    }

                <div class="fun-fact" data-fun-fact-color="#efa80f">
                    <div class="fun-fact-text">
                        <span>عمليات السحب الجارية</span>
                        <h4>@Model.withdrawalNotconfirmedcount</h4>
                    </div>
                    <div class="fun-fact-icon"><i class="fa-solid fa-hourglass-start"></i></div>
                </div>
                <div class="fun-fact" data-fun-fact-color="#28a745">
                    <div class="fun-fact-text">
                        <span>عمليات السحب المكتملة</span>
                        <h4>@Model.withdrawalconfirmedcount</h4>
                    </div>
                    <div class="fun-fact-icon"><i class="fa-solid fa-money-bill-transfer"></i></div>
                </div>
                <div class="fun-fact" data-fun-fact-color="#b81b7f">
                    <div class="fun-fact-text">
                        <span>العروض المرسلة</span>
                        <h4>@Model.SentOffersCount</h4>
                    </div>
                    <div class="fun-fact-icon"><i class="icon-material-outline-business-center"></i></div>
                </div>
                <div class="fun-fact" data-fun-fact-color="#efa80f">
                    <div class="fun-fact-text">
                        <span>التقييمات</span>
                        <h4>@Model.ReviewsCount</h4>
                    </div>
                    <div class="fun-fact-icon"><i class="icon-material-outline-rate-review"></i></div>
                </div>

                <!-- Last one has to be hidden below 1600px, sorry :( -->
                <div class="fun-fact" data-fun-fact-color="#2a41e6">
                    <div class="fun-fact-text">
                        <span>العقود الجارية</span>
                        <h4>@Model.OngoingContractsCount</h4>
                    </div>
                    <div class="fun-fact-icon"><i class="icon-line-awesome-sticky-note-o"></i></div>
                </div>

                <div class="fun-fact" data-fun-fact-color="#36bd78">
                    <div class="fun-fact-text">
                        <span>العقود المنتهية</span>
                        <h4>@Model.FinishedContractsCount</h4>
                    </div>
                    <div class="fun-fact-icon"><i class="icon-material-outline-check"></i></div>
                </div>
            </div>

            <partial name="SmallFooterPartial" />
        </div>
    </div>
    <!-- Dashboard Content / End -->
    <partial name="DashboardPartial" />

</div>
<partial name="/Views/Shared/PaymentBalanceParital.cshtml" />
