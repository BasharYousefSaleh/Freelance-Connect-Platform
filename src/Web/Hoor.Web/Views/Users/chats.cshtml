@model Hoor.Web.ViewModels.Users.Chat

@{
    ViewData["Title"] = " الاستفسارات  ";
}

<div class="dashboard-container ">
    <div class="dashboard-content-container" data-simplebar>
        <div class="dashboard-content-inner">

            <div class="messages-container margin-top-0 boxin">
                <div class="messages-container-inner ">
                    <!-- الرسائل -->
                    <div class="message-content boxin">
                        <div class="messages-headline" style="text-align: center;">
                            <h2> الاستفسارات</h2>
                        </div>

                        <!-- محتوى الرسائل الداخلي -->
                        <div id="chat-messages" class="message-content-inner">
                            <!-- ستظهر الرسائل هنا -->
                        </div>

                        <!-- منطقة الرد -->
                        <div class="message-reply">
                            <textarea id="message-input" cols="1" rows="1" placeholder="اكتب رسالتك هنا..." data-autoresize></textarea>
                            <button id="sendButton" class="button ripple-effect">إرسال</button>
                        </div>
                    </div>
                    <!-- محتوى الرسائل / نهاية -->
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* تنسيق عام */
    .boxin {
        margin-left: 5%;
        margin-right: 5%;
    }

    .user-message {
        background-color: #c82333;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 10px;
        max-width: 60%;
        align-self: flex-end;
        color: #fff;
        text-align: right;
    }

    .ai-message {
        background-color: #f1f1f1;
        padding: 15px;
        border-radius: 10px;
        margin-bottom: 15px;
        max-width: 70%;
        align-self: flex-start;
        border: 1px solid #ddd;
        text-align: right;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

        .ai-message h3 {
            color: #4b6e7d;
            margin: 0 0 10px;
            font-size: 1.2rem;
        }

        .ai-message p {
            margin: 10px 0;
            line-height: 1.6;
            font-size: 1rem;
            color: #333;
        }

        .ai-message .ai-response {
            background-color: #f9f9f9;
            padding: 10px;
            margin-top: 10px;
            border-left: 5px solid #4b6e7d;
        }

    #chat-messages {
        display: flex;
        flex-direction: column;
        gap: 15px;
        padding: 20px;
        overflow-y: auto;
        height: 60vh; /* استخدام وحدات vh لجعل الارتفاع متجاوبًا */
    }

    .message-reply {
        display: flex;
        gap: 10px;
        padding: 10px;
    }

    #message-input {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        resize: none;
        font-size: 1rem;
        text-align: right;
    }

    #sendButton {
        padding: 10px 20px;
        border-radius: 8px;
        background-color: #4b6e7d;
        color: #fff;
        border: none;
        cursor: pointer;
        font-size: 1rem;
    }

        #sendButton:hover {
            background-color: #3b5f6b;
        }

    /* Media Queries للتجاوب */
    @@media (max-width: 768px) {
        .boxin

    {
        margin-left: 2%;
        margin-right: 2%;
    }

    #chat-messages {
        height: 50vh; /* تقليل الارتفاع على الشاشات الصغيرة */
    }

    .user-message, .ai-message {
        max-width: 80%; /* زيادة العرض النسبي للرسائل */
    }

    #message-input {
        font-size: 0.9rem; /* تصغير حجم الخط */
    }

    #sendButton {
        padding: 8px 16px;
        font-size: 0.9rem;
    }

    }

    @@media (max-width: 480px) {
        .boxin

    {
        margin-left: 1%;
        margin-right: 1%;
    }

    #chat-messages {
        height: 40vh; /* تقليل الارتفاع أكثر على الشاشات الصغيرة جدًا */
    }

    .user-message, .ai-message {
        max-width: 90%; /* زيادة العرض النسبي للرسائل */
    }

    #message-input {
        font-size: 0.8rem; /* تصغير حجم الخط أكثر */
    }

    #sendButton {
        padding: 6px 12px;
        font-size: 0.8rem;
    }

    }
</style>

<script>
    document.getElementById('sendButton').addEventListener('click', async function () {
        const userMessage = document.getElementById('message-input').value.trim();
        const chatMessages = document.getElementById('chat-messages');
        document.getElementById('message-input').value = '';

        if (!userMessage) return; // منع إرسال رسائل فارغة

        // عرض رسالة المستخدم
        const userMessageDiv = document.createElement('div');
        userMessageDiv.classList.add('message-text', 'user-message');
        userMessageDiv.textContent = userMessage;
        chatMessages.appendChild(userMessageDiv);

        const promptMessage = `
    تمثل التعليمات التالية الإرشادات التي يجب أن يتبعها النظام للرد على الرسائل الواردة. تأكد من تنفيذ كل بند بدقة:

    1. **لغة الرد**:
       - الرد يجب أن يكون بنفس لغة الرسالة الواردة.
       - إذا كان الطلب يتضمن كتابة كود، يجب تقديم الكود المطلوب بلغة البرمجة ذات الصلة.

    2. **الردود المخصصة**:
       - إذا تضمنت الرسالة النص "من أنت" أو "من برمجك"، قم بالرد بما يلي:
         "أنا ذكاء اصطناعي مخصص للإجابة على أسئلتكم في منصة (حٌر). تم تطويري بواسطة الفريق التالي:
         - المهندس عمران
         - المهندس ممدوح
         - المهندس بشار
         - المهندس  عبد الحكيم."

       - إذا تضمنت الرسالة النص "ما هو عمل الموقع"، "ما هي المنصة"، أو "ما هذا الموقع"، قم بالرد بما يلي:
         "منصة (حٌر) تهدف إلى ربط أصحاب المشاريع والمستقلين بطريقة احترافية وسهلة، حيث توفر للمستقلين فرص عمل عن بُعد عبر الإنترنت، مع ضمان حقوق جميع الأطراف.

         **مميزات المنصة:**
         - **لأصحاب المشاريع**:
           1. نشر الوظائف التي تحتاج إلى إنجازها بسهولة.
           2. استقبال العروض من المستقلين المهتمين.
           3. اختيار المستقل الأنسب بناءً على خبراته وسعره.

         - **للمستقلين**:
           1. استعراض الوظائف المنشورة من أصحاب المشاريع.
           2. تقديم عروض العمل المناسبة لمهاراتك وخبراتك.
           3. انتظار موافقة صاحب المشروع على العرض.

         **خطوات استخدام المنصة:**
         - **لأصحاب المشاريع:**
           1. إنشاء حساب في المنصة.
           2. إضافة تفاصيل الوظيفة المطلوبة (المهام، الميزانية، والمواعيد الزمنية).
           3. استقبال العروض من المستقلين واختيار الأنسب.

         - **للمستقلين:**
           1. إنشاء حساب خاص بك.
           2. استعراض الوظائف المنشورة.
           3. تقديم عرض يتضمن تفاصيل العمل والسعر المقترح.
           4. انتظار قبول صاحب المشروع.

         هدفنا هو تقديم تجربة سلسة وآمنة لجميع الأطراف، وتحقيق أعلى مستويات الجودة في العمل."

    3. **الرد العام**:
       - إذا لم تحتوي الرسالة على النصوص أو المفاهيم المحددة أعلاه، قم بالرد على الرسالة بشكل مباشر بناءً على محتواها.

    **ملاحظات إضافية**:
    - تأكد من استخدام نفس لغة الرسالة الواردة للرد.
    - أجب على أي استفسارات متعلقة بالنصوص المذكورة أعلاه بمعلومات دقيقة ومناسبة.
    - أي طلب يتعلق بالكود يجب تنفيذه باستخدام لغة البرمجة المطلوبة.
    - لا اريد ان تقول انا نموذج لغوي كبير مدرب من قوقل اطلاقاُ.

     هذا هو نص الرسالة التي أرسلتها: ${userMessage}

    `;





        try {
            // إرسال طلب إلى الخادم
            const response = await fetch('https://cozy-perception-production.up.railway.app//generate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ prompt: promptMessage }),
            });

            if (!response.ok) {
                throw new Error(`API Error: ${response.statusText}`);
            }

            const data = await response.json();

            // عرض رد الذكاء الاصطناعي مع تأثير الكتابة
            const aiMessageDiv = document.createElement('div');
            aiMessageDiv.classList.add('chat-message', 'ai-message');
            aiMessageDiv.innerHTML = '<p class="typing-effect" style="margin: 10px 0; line-height: 1.6;"></p>';
            chatMessages.appendChild(aiMessageDiv);

            const aiText = data.text || 'لا يوجد رد';
            typeWriter(aiMessageDiv.querySelector('p'), aiText);

        } catch (error) {
            console.error('Error:', error.message);

            // عرض رسالة الخطأ
            const errorDiv = document.createElement('div');
            errorDiv.classList.add('chat-message', 'ai-message');
            errorDiv.innerHTML = formatAIResponse('حدث خطأ أثناء الاتصال بالخادم: ' + error.message);
            chatMessages.appendChild(errorDiv);
        }

        // مسح المدخل بعد الإرسال
        document.getElementById('message-input').value = '';

        // التمرير التلقائي إلى أسفل
        chatMessages.scrollTop = chatMessages.scrollHeight;
    });

    // دالة لكتابة النص حرفًا بحرف
    function typeWriter(element, text, i = 0) {
        if (i < text.length) {
            element.innerHTML += text.charAt(i);
            setTimeout(() => typeWriter(element, text, i + 1), 10); // تغيير السرعة
        } else {
            // بعد الكتابة، تطبيق التنسيق (إذا لزم الأمر)
            element.innerHTML = formatAIResponse(element.innerHTML);
        }
    }


    function formatAIResponse(response) {
        // Ensure the response includes HTML line breaks or any other required formatting
        const formattedResponse = response
            .replace(/```(.*?)```/gs, (match, code) => {
                // Convert code blocks into <pre><code> tags with a copy button
                const escapedCode = code.replace(/</g, '&lt;').replace(/>/g, '&gt;'); // Escape HTML characters
                const uniqueId = `codeBlock${Math.random().toString(36).substr(2, 9)}`; // Generate a unique ID for each code block
                return `
                    <div style="background-color: #f5f5f5; border: 1px solid #ddd; padding: 10px; border-radius: 5px; margin: 10px 0; overflow-x: auto; position: relative;">
                        <button onclick="copyToClipboard('${uniqueId}')" style="position: absolute; top: 10px; right: 10px; background-color: transparent; border: none; cursor: pointer;">
                            &#x1F4CB; <!-- Unicode for clipboard icon -->
                        </button>
                        <pre id="${uniqueId}" style="margin: 0; white-space: pre-wrap; direction: ltr; text-align: left;"><code>${escapedCode}</code></pre>
                    </div>`;
            })
            .replace(/\n/g, '<br>') // Convert newlines to <br> tags for line breaks
            .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>') // Convert bold markdown to <strong>
            .replace(/\*(.*?)\*/g, '<em>$1</em>'); // Convert italic markdown to <em>

        return `
            <div style="margin-bottom: 10px; direction: rtl; text-align: right;">
                <p style="margin: 10px 0; line-height: 1.6;">
                    ${formattedResponse}
                </p>
            </div>
        `;
    }

    // Function to copy code to clipboard
    function copyToClipboard(elementId) {
        const codeElement = document.getElementById(elementId);
        if (codeElement) {
            const text = codeElement.innerText; // Get the text content of the code block
            navigator.clipboard.writeText(text).then(() => {
                showToast('تم النسخ!');
            }).catch((err) => {
                showToast('حدث خطأ أثناء النسخ: ' + err, true);
            });
        }
    }

    // Function to show a toast message
    function showToast(message, isError = false) {
        const toast = document.createElement('div');
        toast.textContent = message;
        toast.style.position = 'fixed';
        toast.style.bottom = '20px';
        toast.style.right = '20px';
        toast.style.backgroundColor = isError ? '#ff4d4d' : '#4CAF50'; // Red for error, green for success
        toast.style.color = 'white';
        toast.style.padding = '10px 20px';
        toast.style.borderRadius = '5px';
        toast.style.boxShadow = '0 2px 5px rgba(0, 0, 0, 0.3)';
        toast.style.zIndex = '1000';
        toast.style.fontSize = '14px';
        toast.style.opacity = '0';
        toast.style.transition = 'opacity 0.5s ease';

        document.body.appendChild(toast);

        // Show the toast
        setTimeout(() => {
            toast.style.opacity = '1';
        }, 100);

        // Hide and remove the toast after 3 seconds
        setTimeout(() => {
            toast.style.opacity = '0';
            setTimeout(() => {
                document.body.removeChild(toast);
            }, 500);
        }, 3000);
    }


</script>
