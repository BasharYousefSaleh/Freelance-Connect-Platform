<partial name="/Views/Shared/PaymentErrorParital.cshtml" model="@Model"/>

<script>
    function previewImage(event) {
        const reader = new FileReader();
        const imagePreview = document.getElementById('imagePreview');
        const preview = document.getElementById('preview');

        reader.onload = function() {
            if (reader.readyState === 2) {
                preview.src = reader.result;
                imagePreview.style.display = 'block';
            }
        }

        reader.readAsDataURL(event.target.files[0]);
    }

    // إضافة حدث لإغلاق الصورة
    document.getElementById('closeButton').addEventListener('click', function() {
        const imagePreview = document.getElementById('imagePreview');
        const uploadInput = document.getElementById('upload');

        imagePreview.style.display = 'none'; // إخفاء الصورة
        uploadInput.value = ''; // إعادة تعيين حقل الرفع
    });
</script>
<script>
    $(document).on('ready', function () {
      // initialization of clipboard
      $.HSCore.components.HSClipboard.init('.js-clipboard');
    });
</script>
<script>
    $(document).ready(function () {
        $('#CurrnceInput').val('USD');
        $('#CurrnceAmountInput').val(@Model.OfferFixedPrice);
        $('#exchangeinput').hide();
        $('#exchange').hide();
        const exchangeRates = {
            sar: @Currencies.FirstOrDefault(c => c.Id == 5)?.Sale ?? 0,
            yer: @Currencies.FirstOrDefault(c => c.Id == 6)?.Sale ?? 0
        };

        $('input[name="flexRadioDefault"]').change(function () {
            $('#exchange').hide();
            $('#exchangeinput').hide();
            const selectedCurrency = $(this).val();
            const usdAmount = parseFloat($('#OfferFixedPrice').val()) || 0;

            if (selectedCurrency === 'SAR') {
                // const sarAmount = (usdAmount * exchangeRates.sar).toFixed(2);
                const usdToYER = exchangeRates.yer; // سعر الريال اليمني مقابل الدولار
                const yerToSAR = exchangeRates.sar; // سعر الريال السعودي مقابل الريال اليمني

                // تحويل المبلغ من دولار إلى ريال سعودي
                const sarAmount = ((usdToYER / yerToSAR ) * usdAmount ).toFixed(2);
                $('#ExchangeCurr').val(sarAmount);
                $('#ExchangeCurrTitleSAR').show();
                $('#ExchangeCurrTitleYER').hide();
                $('#exchange').show();
                $('#exchangeinput').show();
                $('#CurrnceAmountInput').val(sarAmount);
                
            } else if (selectedCurrency === 'YER') {
                const yerAmount = (usdAmount * exchangeRates.yer).toFixed(2);
                $('#ExchangeCurr').val(yerAmount);
                $('#ExchangeCurrTitleYER').show();
                $('#ExchangeCurrTitleSAR').hide();
                $('#exchange').show();
                $('#exchangeinput').show();
                $('#CurrnceAmountInput').val(yerAmount);
                
            } else {
                $('#exchange').hide();
                $('#exchangeinput').hide();
                $('#CurrnceAmountInput').val(usdAmount);
            }
            $('#CurrnceInput').val(selectedCurrency);
        });
    });
</script>
<script>

    function saveLoclePayment() {
    event.preventDefault(); // منع الإرسال التلقائي للنموذج
    document.getElementById('spinnerloding').style.display = 'inline-block'; // إظهار الحلقة المتحركة
    document.getElementById('btnpyment').style.display = 'none'; // إخفاء زر الإرسال
    var uploadInput = document.getElementById('upload');
    var form = document.getElementById('LocleCheckOout');
    var errorkey = document.getElementById('PaymentErrorKey');

    if (uploadInput.files.length === 0 ) {
        // إذا لم يتم رفع صورة، اجلب الـ Partial View
          setTimeout(function () {
            errorkey.click(); // تنفيذ النقر بعد لحظة قصيرة للتأكد من التنفيذ
        }, 100);
        console.log('error');
        setTimeout(function () {
        document.getElementById('spinnerloding').style.display = 'none'; // إخفاء الحلقة المتحركة
        document.getElementById('btnpyment').style.display = 'inline-block'; // إظهار زر الإرسال
        }, 2000);
      
    } else {
        // إذا كانت الصورة مرفوعة، أرسل النموذج
        form.submit();
    }

    }

</script>
