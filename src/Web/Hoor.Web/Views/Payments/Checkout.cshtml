@using Hoor.Data.Models
@using Microsoft.AspNetCore.Antiforgery
@using Hoor.Common
@using Hoor.Services.Interfaces
@inject IFreelancePlatform freelancePlatform;
@inject IAntiforgery antiforgery

@model Hoor.Web.ViewModels.Contracts.SingleContractViewModel

@{
    var tokenSet = antiforgery.GetAndStoreTokens(this.Context);
}

<style>
    .spinner {
        border: 8px solid #f3f3f3; /* Light grey */
        border-top: 8px solid #3498db; /* Blue */
        border-radius: 50%;
        width: 50px;
        height: 50px;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* إضافة CSS لعنصر حقول البطاقة */
    #card-element {
        width: 100%;
        padding: 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        margin-bottom: 20px;
    }
</style>

<!-- شريط العنوان -->
<div id="titlebar" class="gradient" style="text-align: right">
    <div class="container">
        <div class="row">
            <div class="col-md-12">
                <h2>الدفع</h2>
            </div>
        </div>
    </div>
</div>

<!-- المحتوى -->
<div class="container">
    <div class="row">
        <div class="col-xl-8 col-lg-8 content-right-offset">
            <!-- العنوان -->
            <h3 class="margin-bottom-50" style="text-align: right">طريقة الدفع</h3>
            <p class="font-weight-bold" style="text-align: right; direction: rtl">
                بطاقة اختبار: 4242 4242 4242 4242 مع أي شهر/سنة مستقبلي ورقم CVC عشوائي، ZIP
            </p>

            <!-- قائمة طرق الدفع -->
            <div class="payment margin-top-30">
                <div class="payment-tab payment-tab-active">
                    <div class="payment-tab-trigger">
                        <input checked type="radio" name="cardType" id="creditCart" value="creditCard">
                        <label for="creditCart">بطاقة ائتمان / خصم</label>
                        <img class="payment-logo" src="https://i.imgur.com/IHEKLgm.png" alt="">
                    </div>

                    <div class="payment-tab-content margin-top-20">
                        <div class="col-md-10">
                            <form id="payment-form">
                                <div id="card-element">
                                    <!-- سيتم إنشاء عناصر الإدخال هنا -->
                                </div>

                                <!-- رسائل الخطأ -->
                                <div class="text-danger margin-top-20" id="card-errors" role="alert"></div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- زر الدفع -->
            <button style="text-align: right" type="submit" form="payment-form" class="button big ripple-effect margin-top-40 margin-bottom-65" id="submit" data-secret="@ViewData["ClientSecret"]">ادفع</button>
        </div>

        <!-- spinner التحميل -->
        <div id="loading-spinner" style="display: none; text-align: center; margin-top: 20px;">
            <div class="spinner"></div>
        </div>

        <!-- الملخص -->
        <div class="col-xl-4 col-lg-4 margin-top-0 margin-bottom-60">
            <div class="boxed-widget summary margin-top-0">
                <div class="boxed-widget-headline">
                    <h3 style="text-align: right">الملخص</h3>
                </div>
                <div class="boxed-widget-inner">
                    <ul>
                        @{
                            var fee = (Model.OfferFixedPrice * GlobalConstants.PlatformFeePercentage) / 100;

                            var totalPrice = (Model.OfferFixedPrice + fee);
                        }
                        <li><span>$@Model.OfferFixedPrice.ToString("N2")</span>@Model.OfferJobTitle</li>
                        <li><span>$@fee.ToString("N2")</span>رسوم المنصة (5%)</li>
                        <li class="total-costs"><span>$@totalPrice.ToString("N2")</span>السعر النهائي</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- مكتبة Stripe.js -->
<script src="https://js.stripe.com/v3/"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        // تهيئة Stripe
        var stripe = Stripe('pk_test_51PqIgKAavKQlUUFufcz7lt4ELqsXCgSug1oyq6MDBYznJlYEfcNKmVCIorCJKhJTF6xTINrnOzSeSX4WE9ZQb0Bh00ZyIZN5hZ', {
            stripeAccount: '@ViewData["CurrentUser"]',
            locale: "en"
        });

        // إنشاء عناصر Stripe
        var elements = stripe.elements();
        var style = {
            base: {
                color: "#32325d",
            }
        };

        var card = elements.create("card", { style: style });
        card.mount("#card-element");

        // التعامل مع الأخطاء
        card.on('change', function (event) {
            var displayError = document.getElementById('card-errors');
            if (event.error) {
                displayError.textContent = event.error.message;
            } else {
                displayError.textContent = '';
            }
        });

        // التعامل مع إرسال الفورم
        var form = document.getElementById('payment-form');
        form.addEventListener('submit', function (ev) {
            ev.preventDefault();

            // تعطيل زر الدفع وإظهار spinner
            document.getElementById("submit").setAttribute("disabled", true);
            document.getElementById("submit").style.display = "none";
            document.getElementById("loading-spinner").style.display = "block";

            // تأكيد الدفع
            stripe.confirmCardPayment('@ViewData["ClientSecret"]', {
                payment_method: {
                    card: card,
                    billing_details: {
                        name: '@Model.EmployerFirstName @Model.EmployerLastName'
                    }
                },
            }).then(function (result) {
                if (result.error) {
                    // إظهار خطأ للعميل
                    console.log(result.error.message);
                    document.getElementById("card-errors").textContent = result.error.message;
                    document.getElementById("submit").removeAttribute("disabled");
                    document.getElementById("submit").style.display = "inline-block";
                    document.getElementById("loading-spinner").style.display = "none";
                } else {
                    // الدفع تم بنجاح
                    if (result.paymentIntent.status === 'succeeded') {
                        completeContract();
                        window.location.href = '@Url.Content("~/")'; // إعادة التوجيه إلى الصفحة الرئيسية
                    }
                }
            });
        });

        // دالة لإكمال العقد
        function completeContract() {
            var connection = new signalR.HubConnectionBuilder().withUrl("/TestingHub").build();
            var contractId = "@Model.Id";

            connection.start()
                .then(function () {
                    console.log("SignalR connection established.");
                    connection.invoke("PaymentSucc", contractId)
                        .then(function () {
                            console.log("PaymentSucc invoked successfully with contractId: " + contractId);
                        })
                        .catch(function (err) {
                            console.error("Error invoking PaymentSucc: ", err.toString());
                        });
                })
                .catch(function (err) {
                    console.error("Error establishing connection: ", err.toString());
                });
        }
    });
</script>