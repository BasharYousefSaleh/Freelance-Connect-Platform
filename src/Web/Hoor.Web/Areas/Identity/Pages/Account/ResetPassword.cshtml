@page "/ResetPassword"
@model Hoor.Web.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

<div class="margin-top-100"></div>

<div class="container">
    <div class="row">
        <div class="col-xl-6 offset-xl-3">
            <div class="login-register-page">
                <div class="welcome-text">
                    <h3>قم بإدخال كلمة المرور الجديدة!</h3>
                    <span>يرجى إدخال كلمة المرور الجديدة وتأكيدها.</span>
                </div>

                <form id="reset-password-form" method="post" style="direction:rtl">
                    <div asp-validation-summary="All" class="text-danger"></div>

                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                    <div class="input-with-icon-left" title="يجب أن لا يقل عن 8 أحرف" data-tippy-placement="bottom">
                        <i class="icon-material-outline-lock"></i>
                        <input asp-for="Input.Password" type="password" class="input-text with-border" placeholder="كلمة المرور" required />
                    </div>

                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    <div class="input-with-icon-left">
                        <i class="icon-material-outline-lock"></i>
                        <input asp-for="Input.ConfirmPassword" type="password" class="input-text with-border" placeholder="تأكيد كلمة المرور" required />
                    </div>
                </form>

                <button class="button full-width button-sliding-icon ripple-effect margin-top-10" form="reset-password-form" type="submit">
                    تغيير كلمة المرور <i class="icon-material-outline-arrow-right-alt"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="margin-bottom-100"></div>

<partial name="BigFooterPartial" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
